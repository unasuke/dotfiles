{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "mcp__pencil"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@2.2.7",
    "padding": 0
  },
  "enabledPlugins": {
    "claude-code-wakatime@wakatime": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "stripe@claude-plugins-official": true,
    "ruby-skills@ruby-skills": false,
    "ruby-lsp@claude-plugins-official": true,
    "sorah-spec@sorah-marketplace": true,
    "sorah-guides@sorah-marketplace": true,
    "gopls-lsp@claude-plugins-official": true,
    "use-workshop@canonical": true
  },
  "extraKnownMarketplaces": {
    "sorah-marketplace": {
      "source": {
        "source": "github",
        "repo": "sorah/config"
      }
    },
    "googlechrome": {
      "source": {
        "source": "github",
        "repo": "GoogleChrome/modern-web-guidance"
      }
    },
    "canonical": {
      "source": {
        "source": "github",
        "repo": "canonical/use-workshop-skill"
      }
    }
  },
  "language": "Japanese",
  "plansDirectory": ".claude/plans",
  "skipWorkflowUsageWarning": true,
  "preferredNotifChannel": "terminal_bell",
  "remoteControlAtStartup": false
}
